{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downtime",
  "version": "0.1.0",
  "identifier": "com.downtime.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "create": false,
        "title": "Downtime Overlay",
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "fullscreen": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "home",
        "create": false,
        "title": "Downtime",
        "decorations": false,
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
